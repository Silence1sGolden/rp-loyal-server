    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "eslint": "^9.35.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
